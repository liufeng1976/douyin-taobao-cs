# === AI 配置 ===
DEEPSEEK_API_KEY=sk-your-deepseek-key
AI_MODEL=deepseek-chat

# === 数据库 ===
DATABASE_URL=file:./prisma/dev.db

# === 应用配置 ===
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# === 抖音开放平台 ===
DOUYIN_APP_KEY=your-douyin-app-key
DOUYIN_APP_SECRET=your-douyin-app-secret
DOUYIN_SHOP_ID=your-shop-id

# === 淘宝开放平台 (千牛) ===
TAOBAO_APP_KEY=your-taobao-app-key
TAOBAO_APP_SECRET=your-taobao-app-secret
TAOBAO_SESSION_KEY=your-session-key

# === 加密密钥 ===
ENCRYPTION_KEY=change-me-to-a-random-32-char-string
