# === BossAI OS bounded AI gateway ===
BOSSAI_OS_URL=http://127.0.0.1:3001
BOSSAI_OS_API_KEY=
BOSSAI_AI_MODEL=bossai-balanced
BOSSAI_AI_TIMEOUT_MS=15000

# === Canonical BossAI Customer Service intake ===
# Canonical bossai-commerce-copilot API defaults to loopback port 4190.
BOSSAI_CUSTOMER_SERVICE_URL=http://127.0.0.1:4190
# Optional forward/reverse-proxy credential. Current canonical local API does not require x-api-key.
BOSSAI_CUSTOMER_SERVICE_API_KEY=
CONNECTOR_BRIDGE_TIMEOUT_MS=4000
CONNECTOR_BRIDGE_RETRIES=2
# Official marketplace callbacks need a fast ACK. The webhook path uses this
# short fail-closed intake timeout and lets the platform retry on 5xx.
WEBHOOK_BRIDGE_TIMEOUT_MS=120

# === Local adapter service ===
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
ALLOW_UNAUTHENTICATED_LOCAL=true
API_KEYS=
REQUIRE_SIGNED_WEBHOOKS=false

# === Douyin Shop / 抖店 inbound channel ===
# Public-source/offline default is false. Set true only when you have a real merchant app and intend to accept Douyin traffic.
DOUYIN_ENABLED=false
DOUYIN_APP_KEY=
DOUYIN_APP_SECRET=
DOUYIN_SHOP_ID=
DOUYIN_ACCOUNT_REF=
# Must match the signature algorithm selected in the Douyin Open Platform console.
# Recommended when available: hmac-sha256. Legacy deployments may still use md5.
DOUYIN_WEBHOOK_SIGN_METHOD=hmac-sha256

# === Taobao / Tmall / Qianniu inbound channel ===
# Public-source/offline default is false. Set true only when you have a real merchant app and intend to accept Taobao/Tmall traffic.
TAOBAO_ENABLED=false
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_SESSION_KEY=
TAOBAO_ACCOUNT_REF=
TAOBAO_CHANNEL=taobao
# Read-only order facts are an explicit later action, never part of webhook ACK.
TAOBAO_API_URL=https://gw.api.taobao.com/router/rest
